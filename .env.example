# Copy to .env for local development. Never commit real secrets.
# Use only with the dedicated Partner app "Legends BAGS Dev" and a Shopify *development* store.

SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SCOPES=read_products,write_products,read_orders,read_themes
SHOPIFY_APP_URL=https://example.com

# Shared secret for HMAC download links (min 16 chars)
FILE_SIGNING_SECRET=dev-only-change-me-32chars

# Optional — higher-quality background removal (falls back to local algorithm)
REMOVE_BG_API_KEY=


# Must be a Shopify development store domain (*.myshopify.com), never production
DEV_SHOP=

# Process one render job inside orders/paid webhook (dev convenience)
RENDER_INLINE_ON_WEBHOOK=1

LOCAL_STORAGE_ROOT=./storage/local
