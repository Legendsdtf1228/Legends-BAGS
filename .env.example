# Copy to .env for local development. Never commit real secrets.
# Use only with the dedicated Partner app "Legends BAGS Dev" and a Shopify *development* store.

SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SCOPES=read_products,write_products,read_orders,read_themes
# Production (Railway): https://upload-by-size-production.up.railway.app
SHOPIFY_APP_URL=https://example.com

# Shared secret for HMAC download links (min 16 chars)
FILE_SIGNING_SECRET=dev-only-change-me-32chars

# Optional — higher-quality background removal (falls back to local algorithm)
REMOVE_BG_API_KEY=

# SQLite — local dev uses prisma/dev.sqlite; Railway uses a volume at /data
DATABASE_URL="file:./dev.sqlite"

# Must be a Shopify development store domain (*.myshopify.com), never production
DEV_SHOP=

# Dev/editor API token (storefront session testing, worker tick, E2E scripts)
TEST_API_TOKEN=

# Process one render job inside orders/paid webhook (dev convenience)
RENDER_INLINE_ON_WEBHOOK=1

# Local file storage — Railway: mount a volume at /data and use /data/storage
LOCAL_STORAGE_ROOT=./storage/local

# --- Railway (set in the Railway service dashboard, not in .env) ---
# DATABASE_URL=file:/data/prod.sqlite
# LOCAL_STORAGE_ROOT=/data/storage
# SHOPIFY_APP_URL=https://<your-service>.up.railway.app
#   (Railway injects RAILWAY_PUBLIC_DOMAIN — use it to build SHOPIFY_APP_URL)
# HOST=0.0.0.0  (set in Dockerfile; Railway sets PORT automatically)
