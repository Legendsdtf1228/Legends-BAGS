{% comment %}
  Legends Gang Sheet — full canvas builder launcher.
{% endcomment %}

<div
  id="lgs-gang-sheet"
  class="lgs-gs"
  data-product-id="{{ product.id }}"
  data-product-gid="gid://shopify/Product/{{ product.id }}"
  data-variant-id="{{ product.selected_or_first_available_variant.id }}"
  data-shop="{{ shop.permanent_domain }}"
  data-builder-type="gang_sheet"
  data-editor-base="{{ block.settings.editor_base_url }}"
>
  <button type="button" class="lgs-gs__launch" data-lgs-open>
    {{ block.settings.button_label }}
  </button>
  <p class="lgs-gs__hint">{{ block.settings.hint_text }}</p>
  <p class="lgs-gs__warn" data-lgs-design-warn role="status" tabindex="-1">
    Design required — open the builder and save before adding this product to cart.
  </p>
  <p class="lgs-gs__attached" data-lgs-design-attached hidden role="status"></p>
  <p class="lgs-gs__status" data-lgs-status hidden aria-live="polite"></p>
  <div class="lgs-gs__frame-wrap" hidden data-lgs-frame-wrap>
    <iframe
      title="Gang Sheet Builder"
      class="lgs-gs__frame"
      data-lgs-frame
      allow="clipboard-read; clipboard-write"
    ></iframe>
    <button type="button" class="lgs-gs__close" data-lgs-close>Close</button>
  </div>
</div>

{% schema %}
{
  "name": "LGS Gang Sheet Builder",
  "target": "section",
  "stylesheet": "gang-sheet.css",
  "javascript": "lgs-launcher.js",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Build your gang sheet"
    },
    {
      "type": "text",
      "id": "hint_text",
      "label": "Hint",
      "default": "Upload artwork, arrange on the sheet, then save to add to cart."
    },
    {
      "type": "text",
      "id": "editor_base_url",
      "label": "Editor base URL (dev app URL)",
      "info": "Paste the current shopify app dev tunnel URL, e.g. https://xxxx.trycloudflare.com"
    }
  ]
}
{% endschema %}
