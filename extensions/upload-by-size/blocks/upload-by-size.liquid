{% comment %}
  Legends Gang Sheet — Upload by Size launcher.
{% endcomment %}

<div
  id="lgs-upload-by-size"
  class="lgs-ubs"
  data-product-id="{{ product.id }}"
  data-product-gid="gid://shopify/Product/{{ product.id }}"
  data-variant-id="{{ product.selected_or_first_available_variant.id }}"
  data-shop="{{ shop.permanent_domain }}"
  data-customer-id="{% if customer %}{{ customer.id }}{% endif %}"
  data-builder-type="upload_by_size"
  data-editor-base="{{ block.settings.editor_base_url }}"
>
  <button type="button" class="lgs-ubs__launch" data-lgs-open data-label-open="{{ block.settings.button_label }}" data-label-edit="Edit design">
    {{ block.settings.button_label }}
  </button>
  <button type="button" class="lgs-ubs__edit" data-lgs-edit hidden>Edit design</button>
  <button type="button" class="lgs-ubs__reset" data-lgs-reset hidden>Start over</button>
  <p class="lgs-ubs__hint">{{ block.settings.hint_text }}</p>
  <p class="lgs-ubs__warn" data-lgs-design-warn role="status" tabindex="-1">
    Design required — open the editor and save before adding this product to cart.
  </p>
  <p class="lgs-ubs__attached" data-lgs-design-attached hidden role="status"></p>
  <p class="lgs-ubs__status" data-lgs-status hidden aria-live="polite"></p>
  <div class="lgs-ubs__frame-wrap" hidden data-lgs-frame-wrap aria-hidden="true" role="dialog" aria-modal="true" aria-label="Upload by Size">
    <p class="lgs-ubs__loading" data-lgs-loading hidden>Loading editor…</p>
    <iframe
      title="Upload by Size"
      class="lgs-ubs__frame"
      data-lgs-frame
      allow="clipboard-read; clipboard-write"
    ></iframe>
    <button type="button" class="lgs-ubs__close" data-lgs-close>Close</button>
  </div>
</div>

{% schema %}
{
  "name": "LGS Upload by Size",
  "target": "section",
  "stylesheet": "upload-by-size.css",
  "javascript": "lgs-launcher.js",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Upload artwork by size"
    },
    {
      "type": "text",
      "id": "hint_text",
      "label": "Hint",
      "default": "Transparent PNG recommended. Price is calculated from printed area."
    },
    {
      "type": "text",
      "id": "editor_base_url",
      "label": "Editor base URL (dev app URL)",
      "info": "Paste the current shopify app dev tunnel URL, e.g. https://xxxx.trycloudflare.com"
    }
  ]
}
{% endschema %}
